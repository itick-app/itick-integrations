# --- Requis ---
# Clé API ITICK (sandbox itick_sandbox_… en test, itick_… en prod).
ITICK_API_KEY=itick_sandbox_xxx
# Secret de signature du webhook Stripe : Dashboard Stripe → Developers → Webhooks
# → votre endpoint → « Signing secret ».
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Identité émetteur — exigée par ITICK en mode structuré.
MERCHANT_SIRET=12345678901234
MERCHANT_EMAIL=facturation@maboutique.fr
MERCHANT_PHONE=+33100000000

# --- Optionnel ---
# Base URL ITICK (défaut : https://api.itick.fr/itick).
# ITICK_BASE_URL=https://api.itick.fr/itick
# Port d'écoute (défaut 3000).
# PORT=3000
# Interface d'écoute (défaut 127.0.0.1 : le service n'a pas de TLS, il se place
# derrière un reverse-proxy). Dans un conteneur, mettez 0.0.0.0.
# HOST=127.0.0.1
# Chemin du webhook (défaut /webhooks/stripe).
# WEBHOOK_PATH=/webhooks/stripe
# Événements Stripe traités, séparés par des virgules (défaut invoice.paid).
# STRIPE_EVENTS=invoice.paid
# Votre raison sociale (sinon le nom du compte Stripe est utilisé).
# MERCHANT_NAME=Ma Boutique SAS
# TVA % appliquée aux lignes SANS taux Stripe. Aucun défaut : si vous ne la
# renseignez pas, ces factures sont REFUSÉES (le connecteur n'invente pas de
# TVA). Mettez 0 si vous êtes en franchise en base de TVA.
# DEFAULT_VAT_RATE=20
